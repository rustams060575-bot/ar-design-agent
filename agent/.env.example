# Copy to agent/.env for local runs (never commit .env). In GitHub Actions use repository secrets.

# Gmail SMTP login. Use a 16-char App Password (Google Account -> Security -> 2-Step Verification -> App passwords).
# Accepted formats: the bare password, user@gmail.com:password, or {"email": "...", "app_password": "..."}
GMAIL_APP_PASSWORD=

# Pitch generation and lead qualification: set one of them (Anthropic is preferred when both are set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram: create a bot with @BotFather, then get your chat id (e.g. via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional and legacy: the webhook secret is derived from TELEGRAM_BOT_TOKEN, nothing to copy to Vercel.
# TELEGRAM_WEBHOOK_SECRET=


# Super-admin of the Telegram bot: your numeric Telegram id (ask @userinfobot). Only this user gets /admin, /stats, /leads and the lead-card buttons.
# If empty, TELEGRAM_CHAT_ID is used. Keep the two equal so GitHub Actions reports reach the same person.
ADMIN_TELEGRAM_ID=

# Instagram comment -> Direct auto-reply (Vercel only, api/instagram.js; works under any post/Reel of the account).
# Webhook URL in Meta for Developers (app -> Webhooks -> Instagram): https://<your-vercel-domain>/api/instagram
# Verify token = the value of META_VERIFY_TOKEN below. Subscribe the `comments` field.
# Required in Vercel (Production), then Redeploy:
META_VERIFY_TOKEN=            # any string you choose (alias: IG_VERIFY_TOKEN)
META_APP_SECRET=              # Meta app -> Settings -> Basic -> App Secret, of the SAME app that owns the webhook (alias: IG_APP_SECRET)
IG_ACCESS_TOKEN=              # token of that same app with instagram_manage_comments + instagram_manage_messages
IG_USER_ID=                   # id of the Instagram professional account (@ar_design_agency)
# Optional (defaults in brackets):
TRIGGER_KEYWORDS=motion       # comma separated code words, any case, whole word [motion]
REPLY_LINK=https://t.me/aur_design_bot?start=motion   # (alias: IG_FUNNEL_LINK)
REPLY_MESSAGE=                # full DM text, "{link}" is replaced by REPLY_LINK [Spanish text from api/_lib/instagram.js] (alias: IG_DM_TEXT)
# IG_API_VERSION=v21.0   IG_GRAPH_HOST=graph.facebook.com
