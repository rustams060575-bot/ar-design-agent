{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/tiktok-callback",
      "destination": "/api/tiktok?action=callback"
    }
  ],
  "crons": [
    {
      "path": "/api/channel_cron",
      "schedule": "0 15 * * 1,3,5"
    },
    {
      "path": "/api/cron",
      "schedule": "0 7 * * *"
    }
  ],
  "installCommand": "",
  "buildCommand": "",
  "functions": {
    "api/telegram.js": {
      "maxDuration": 60
    },
    "api/instagram.js": {
      "maxDuration": 30
    },
    "api/tiktok.js": {
      "maxDuration": 60
    },
    "api/channel_cron.js": {
      "maxDuration": 60
    },
    "api/miniapp_lead.js": {
      "maxDuration": 30
    },
    "api/cron.js": {
      "maxDuration": 20
    },
    "api/publish.py": {
      "maxDuration": 60,
      "includeFiles": "agent/meta_publisher.py"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "https://withardesign.com",
      "permanent": true
    }
  ]
}
